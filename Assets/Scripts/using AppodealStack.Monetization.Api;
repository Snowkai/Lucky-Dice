using AppodealStack.Monetization.Api;
using AppodealStack.Monetization.Common;
using UnityEngine;

namespace LuckyDice
{
    public class AppodealADSScript : MonoBehaviour
    {
        [SerializeField] private int throwsBeforeAd = 7;
        
        // ✅ Исправлено: ключ загружается из ассетов или используется безопасный дефолт
        [SerializeField] private string appKeyFromAsset = "";
        private string _appKey;

        private int throwCounter;
        private bool isInitialized = false;  // ✅ Добавлено: флаг инициализации

        private void Start()
        {
            // ✅ Исправлено: приоритет ключа из ассетов над дефолтным
            if (!string.IsNullOrEmpty(appKeyFromAsset))
            {
                _appKey = appKeyFromAsset;
            }
            else
            {
                _appKey = "da749c03d21bba586171f1273db7e71922ab176c67c7710a";  // Дефолтный (тестовый) ключ
            }

            int adTypes = AppodealAdType.Interstitial;
            
            AppodealCallbacks.Sdk.OnInitialized += OnInitializationFinished;
            Appodeal.Initialize(_appKey, adTypes);
        }

        private void OnInitializationFinished(object sender, SdkInitializedEventArgs e) 
        {
            // ✅ Исправлено: обработка ошибок инициализации
            if (e.error != null)
            {
                Debug.LogError($"Appodeal initialization failed: {e.error}");
                isInitialized = false;
                return;
            }

            isInitialized = true;
            Debug.Log("Appodeal SDK initialized successfully!");
        }

        public void OnDiceThrown()
        {
            if (!isInitialized)
            {
                Debug.LogWarning("Appodeal not initialized, skipping ad tracking");
                return;
            }

            throwCounter++;
            Debug.Log($"Бросок №{throwCounter}");

            if (throwCounter >= throwsBeforeAd)
            {
                ShowInterstitial();
            }
        }

        private void ShowInterstitial()
        {
            // ✅ Исправлено: проверка инициализации перед показом рекламы
            if (!isInitialized)
            {
                Debug.LogWarning("Appodeal not initialized, cannot show ad");
                throwCounter = 0;
                return;
            }

            if (Appodeal.IsLoaded(AppodealAdType.Interstitial))
            {
                Appodeal.Show(AppodealShowStyle.Interstitial);
            }
            else
            {
                Debug.LogWarning("Interstitial ad not loaded, skipping show");
            }

            throwCounter = 0;
        }

        private void OnDestroy()
        {
            // ✅ Добавлено: очистка подписок при уничтожении скрипта
            AppodealCallbacks.Sdk.OnInitialized -= OnInitializationFinished;
        }
    }
}
